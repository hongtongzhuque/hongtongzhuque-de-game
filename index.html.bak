function showUnlockMessage() {
    // 仅在对应页面的提示尚未显示过时才播放一次动画（通过 localStorage 标记）
    const visibleScreen = Object.values(screens).find(s => s && !s.classList.contains('hidden'));
    if (!visibleScreen) return;
    const msg = visibleScreen.querySelector('.unlock-message');
    if (!msg) return;

    const screenSeenMap = {
        sixthScreen: 'seenUnlock1',
        seventhScreen: 'seenUnlock2',
        thirdScreen: 'seenUnlock3',
        fourthScreen: 'seenUnlock4',
        fifthScreen: 'seenUnlock5',
        eighthScreen: 'seenUnlock6',
        ninthScreen: 'seenUnlock7',
        tenthScreen: 'seenUnlock8',
        eleventhScreen: 'seenUnlock9',
        twelfthScreen: 'seenUnlock10',
        thirteenthScreen: 'seenUnlock11',
        fourteenthScreen: 'seenUnlock12',
        fifteenthScreen: 'seenUnlock13',
        sixteenthScreen: 'seenUnlock14'
    };
    const seenKey = screenSeenMap[visibleScreen.id];
    if (seenKey && localStorage.getItem(seenKey) === 'true') return;

    msg.textContent = '*已寻找到新线索*';
    if (msg._unlockMsgTimeout) { clearTimeout(msg._unlockMsgTimeout); msg._unlockMsgTimeout = null; }
    msg.style.transition = 'opacity 0.35s ease, visibility 0s linear 0s';
    msg.style.visibility = 'visible';
    msg.style.opacity = '0';
    // 强制回流
    // eslint-disable-next-line no-unused-expressions
    msg.offsetWidth;
    requestAnimationFrame(() => {
        msg.style.opacity = '1';
        msg._unlockMsgTimeout = setTimeout(() => {
            msg.style.opacity = '0';
            setTimeout(() => {
                msg.style.visibility = 'hidden';
                msg.style.transition = '';
                msg._unlockMsgTimeout = null;
            }, 360);
        }, 2200);
    });

    if (seenKey) localStorage.setItem(seenKey, 'true');
}

function unlockCode(codeNum) {
    localStorage.setItem(`unlocked${codeNum}`, "true");
    checkUnlocks();
}

function showToastNotification(message) {
    const toast = document.getElementById('toastNotification');
    if (!toast) return;
    
    toast.textContent = message;
    toast.classList.add('show');
    
    playNotificationSound();
    
    toast.onclick = () => {
        if (message === '未知的来信2') {
            unlockCode(2);
            showScreen('seventh');
            showUnlockMessage();
            toast.classList.remove('show');
        }
    };
    
    setTimeout(() => {
        toast.classList.remove('show');
        toast.onclick = null;
    }, 7000);
}

function animateStoryText() {
    const storyContent = document.querySelector('.story-content');
    if (!storyContent) return;

    // 防止重复执行
    if (storyContent.dataset.animated === 'true') return;
    storyContent.dataset.animated = 'true';

    // 保存原始 HTML 以便重置时恢复
    if (!storyContent.dataset.originalHtml) {
        storyContent.dataset.originalHtml = storyContent.innerHTML;
    }

    const paragraphs = storyContent.querySelectorAll('p');
    const charDelay = 85; // 每个字间隔85ms，模拟打字机节奏

    let charIndex = 0;

    paragraphs.forEach((p) => {
        const originalNodes = Array.from(p.childNodes);
        p.innerHTML = '';

        const wrapNode = (node, container) => {
            if (node.nodeType === Node.TEXT_NODE) {
                const text = node.textContent;
                for (const char of text) {
                    const span = document.createElement('span');
                    span.textContent = char;
                    span.className = 'story-char';
                    span.style.animationDelay = `${charIndex * charDelay}ms`;
                    container.appendChild(span);
                    charIndex++;
                }
            } else if (node.nodeType === Node.ELEMENT_NODE) {
                const clone = node.cloneNode(false);
                container.appendChild(clone);
                node.childNodes.forEach(child => wrapNode(child, clone));
            }
        };

        originalNodes.forEach(node => wrapNode(node, p));
    });
}

function initInputs() {
    unlockCode1.onclick = () => { playPageTurnSound(); showScreen("sixth"); showUnlockMessage(); };
    unlockCode2.onclick = () => { playPageTurnSound(); showScreen("seventh"); showUnlockMessage(); };
    unlockCode3.onclick = () => { playPageTurnSound(); showScreen("third"); showUnlockMessage(); };
    unlockCode4.onclick = () => { playPageTurnSound(); showScreen("fourth"); showUnlockMessage(); };
    unlockCode5.onclick = () => { playPageTurnSound(); showScreen("fifth"); showUnlockMessage(); };
    unlockCode6.onclick = () => { playPageTurnSound(); showScreen("eighth"); showUnlockMessage(); };
    unlockCode7.onclick = () => { playPageTurnSound(); showScreen("ninth"); showUnlockMessage(); };
    unlockCode8.onclick = () => { playPageTurnSound(); showScreen("tenth"); showUnlockMessage(); };
    unlockCode9.onclick = () => { playPageTurnSound(); showScreen("eleventh"); showUnlockMessage(); };
    unlockCode10.onclick = () => { playPageTurnSound(); showScreen("twelfth"); showUnlockMessage(); };
    unlockCode11.onclick = () => { playPageTurnSound(); showScreen("thirteenth"); showUnlockMessage(); };
    unlockCode12.onclick = () => { playPageTurnSound(); showScreen("fourteenth"); showUnlockMessage(); };
    unlockCode13.onclick = () => { playPageTurnSound(); showScreen("fifteenth"); showUnlockMessage(); };
    unlockCode14.onclick = () => { playPageTurnSound(); showScreen("sixteenth"); showUnlockMessage(); };

    function handleInput(input, page) {
        input.addEventListener("keydown", e => {
            if (e.key !== "Enter") return;
            const cmd = input.value.trim().toLowerCase();
            input.value = "";
            // 除了 start 页面外，任何页面输入对应线索都应能跳转到目标页面
            if (page !== "start") {
                if (cmd === CODE1.toLowerCase()) {
                    unlockCode(1);
                    showScreen("sixth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE2.toLowerCase()) {
                    unlockCode(2);
                    showScreen("seventh");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE3.toLowerCase()) {
                    unlockCode(3);
                    showScreen("third");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE4.toLowerCase()) {
                    unlockCode(4);
                    showScreen("fourth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE5.toLowerCase()) {
                    unlockCode(5);
                    showScreen("fifth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE6.toLowerCase()) {
                    unlockCode(6);
                    showScreen("eighth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE7.toLowerCase()) {
                    unlockCode(7);
                    showScreen("ninth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE8.toLowerCase()) {
                    unlockCode(8);
                    showScreen("tenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE9.toLowerCase()) {
                    unlockCode(9);
                    showScreen("eleventh");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE10.toLowerCase()) {
                    unlockCode(10);
                    showScreen("twelfth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE11.toLowerCase()) {
                    unlockCode(11);
                    showScreen("thirteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE12.toLowerCase()) {
                    unlockCode(12);
                    showScreen("fourteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE13.toLowerCase()) {
                    unlockCode(13);
                    showScreen("fifteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE14.toLowerCase()) {
                    unlockCode(14);
                    showScreen("sixteenth");
                    showUnlockMessage();
                    return;
                }
            }

            if (cmd === "list" || cmd === "help") {
                showScreen("info");
                checkUnlocks();
                return;
            }

            if (page === "start" && cmd === "game start") {
                showScreen("info");
                checkUnlocks();
            }

            if (page === "info") {
                if (cmd === CODE1.toLowerCase()) {
                    unlockCode(1);
                    showScreen("sixth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE2.toLowerCase()) {
                    unlockCode(2);
                    showScreen("seventh");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE3.toLowerCase()) {
                    unlockCode(3);
                    showScreen("third");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE4.toLowerCase()) {
                    unlockCode(4);
                    showScreen("fourth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE5.toLowerCase()) {
                    unlockCode(5);
                    showScreen("fifth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE6.toLowerCase()) {
                    unlockCode(6);
                    showScreen("eighth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE7.toLowerCase()) {
                    unlockCode(7);
                    showScreen("ninth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE8.toLowerCase()) {
                    unlockCode(8);
                    showScreen("tenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE9.toLowerCase()) {
                    unlockCode(9);
                    showScreen("eleventh");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE10.toLowerCase()) {
                    unlockCode(10);
                    showScreen("twelfth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE11.toLowerCase()) {
                    unlockCode(11);
                    showScreen("thirteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE12.toLowerCase()) {
                    unlockCode(12);
                    showScreen("fourteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE13.toLowerCase()) {
                    unlockCode(13);
                    showScreen("fifteenth");
                    showUnlockMessage();
                    return;
                } else if (cmd === CODE14.toLowerCase()) {
                    unlockCode(14);
                    showScreen("sixteenth");
                    showUnlockMessage();
                    return;
                }
            }

            if (page === "third" && cmd === "back") showScreen("info");
            if (page === "fourth" && cmd === "back") showScreen("info");
            if (page === "fifth" && cmd === "back") showScreen("info");
            if (page === "sixth" && cmd === "back") showScreen("info");
            if (page === "seventh" && cmd === "back") showScreen("info");
            if (page === "eighth" && cmd === "back") showScreen("info");
            if (page === "ninth" && cmd === "back") showScreen("info");
            if (page === "tenth" && cmd === "back") showScreen("info");
            if (page === "eleventh" && cmd === "back") showScreen("info");
            if (page === "twelfth" && cmd === "back") showScreen("info");
            if (page === "thirteenth" && cmd === "back") showScreen("info");
            if (page === "fourteenth" && cmd === "back") showScreen("info");
            if (page === "fifteenth" && cmd === "back") showScreen("info");
            if (page === "sixteenth" && cmd === "back") showScreen("info");
            // 输入错误线索时触发红色警告
            if (cmd && cmd !== "back") {
                const dangerOverlay = document.getElementById('dangerOverlay');
                if (dangerOverlay) {
                    dangerOverlay.classList.remove('hidden');
                    dangerOverlay.setAttribute('aria-hidden', 'false');
                    requestAnimationFrame(() => dangerOverlay.classList.add('show'));

                    // 播放恐怖警告音效
                    playDangerSound();

                    setTimeout(() => {
                        dangerOverlay.classList.remove('show');
                        dangerOverlay.setAttribute('aria-hidden', 'true');
                        setTimeout(() => dangerOverlay.classList.add('hidden'), 220);
                    }, 1400);
                }
                return;
            }

        });
    }

    handleInput(inputs.story, "story");
    handleInput(inputs.info, "info");
    handleInput(inputs.sixth, "sixth");
    handleInput(inputs.seventh, "seventh");
    handleInput(inputs.third, "third");
    handleInput(inputs.fourth, "fourth");
    handleInput(inputs.fifth, "fifth");
    handleInput(inputs.eighth, "eighth");
    handleInput(inputs.ninth, "ninth");
    handleInput(inputs.tenth, "tenth");
    handleInput(inputs.eleventh, "eleventh");
    handleInput(inputs.twelfth, "twelfth");
    handleInput(inputs.thirteenth, "thirteenth");
    handleInput(inputs.fourteenth, "fourteenth");
    handleInput(inputs.fifteenth, "fifteenth");
    handleInput(inputs.sixteenth, "sixteenth");
}

// 恐怖淡出效果：文字模糊暗淡后屏幕不规则闪烁，营造悬疑氛围
function horrorFadeOut(callback) {
    const introScreen = document.getElementById('introScreen');
    const introContent = document.querySelector('.intro-content');
    const cursor = document.querySelector('.intro-cursor');

    if (!introScreen || !introContent) {
        if (callback) callback();
        return;
    }

    // 隐藏光标
    if (cursor) cursor.style.opacity = '0';
    introScreen.style.backgroundColor = '#0a0000';

    // 阶段1：文字剧烈闪烁后消失 (0~0.9s)
    introContent.style.transition = 'none';
    const textFlickers = [
        { t: 30,  o: 0.2, f: 'blur(2px) brightness(0.6)' },
        { t: 60,  o: 0.9, f: 'blur(0px) brightness(1)' },
        { t: 100, o: 0.1, f: 'blur(3px) brightness(0.3)' },
        { t: 140, o: 0.8, f: 'blur(1px) brightness(0.8)' },
        { t: 180, o: 0.05,f: 'blur(5px) brightness(0.2)' },
        { t: 220, o: 0.7, f: 'blur(1px) brightness(0.9)' },
        { t: 270, o: 0.0, f: 'blur(4px) brightness(0.15)' },
        { t: 320, o: 0.6, f: 'blur(2px) brightness(0.7)' },
        { t: 360, o: 0.0, f: 'blur(3px) brightness(0.1)' },
        { t: 420, o: 0.4, f: 'blur(2px) brightness(0.5)' },
        { t: 470, o: 0.0, f: 'blur(5px) brightness(0.1)' },
        { t: 530, o: 0.15,f: 'blur(3px) brightness(0.3)' },
        { t: 580, o: 0.0, f: 'blur(6px) brightness(0)' },
    ];
    textFlickers.forEach(({ t, o, f }) => {
        setTimeout(() => {
            introContent.style.opacity = String(o);
            introContent.style.filter = f;
        }, t);
    });
    // 文字最终熄灭
    setTimeout(() => {
        introContent.style.transition = 'opacity 0.3s ease-in, filter 0.3s ease-in';
        introContent.style.opacity = '0';
        introContent.style.filter = 'blur(6px) brightness(0)';
    }, 620);

    // 阶段2：屏幕遮罩轻柔过渡 (0.6s ~ 1.5s，降低闪烁强度)
    setTimeout(() => {
        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;background:#000;z-index:3001;pointer-events:none;opacity:0.35;';
        document.body.appendChild(overlay);

        // 少量轻柔闪烁，幅度不大
        const flickers = [
            { t: 60,  o: 0.55, d: 80 },{ t: 160, o: 0.3, d: 90 },
            { t: 270, o: 0.5, d: 80 },{ t: 380, o: 0.35, d: 70 },
            { t: 480, o: 0.55, d: 90 },{ t: 580, o: 0.4, d: 80 },
        ];

        flickers.forEach(({ t, o, d }) => {
            setTimeout(() => {
                overlay.style.transition = `opacity ${d}ms ease-in-out`;
                overlay.style.opacity = String(o);
            }, t);
        });

        // 阶段3：最终熄灭 → 回调
        setTimeout(() => {
            overlay.style.transition = 'opacity 0.3s ease-in';
            overlay.style.opacity = '1';
            setTimeout(() => {
                overlay.remove();
                introContent.style.transition = '';
                introContent.style.filter = '';
                introScreen.style.transition = '';
                introScreen.style.backgroundColor = '';
                if (cursor) cursor.style.opacity = '';
                if (callback) callback();
            }, 350);
        }, 750);
    }, 500);
}

// 粒子消散效果：将开场文字转化为粒子飘散
function dissipateCharacters(callback) {
    const introScreen = document.getElementById('introScreen');
    const introContent = document.querySelector('.intro-content');
    const cursor = document.querySelector('.intro-cursor');

    if (!introScreen || !introContent) {
        if (callback) callback();
        return;
    }

    // 收集所有已显示的字符元素
    const charEls = [
        ...document.querySelectorAll('.intro-char.show'),
        ...document.querySelectorAll('.intro-subchar.show')
    ];

    // 创建画布覆盖层
    const canvas = document.createElement('canvas');
    canvas.className = 'dissolve-canvas';
    document.body.appendChild(canvas);
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const ctx = canvas.getContext('2d');

    const particles = [];

    // 为每个字符生成粒子（模拟风吹散效果）
    charEls.forEach(el => {
        const rect = el.getBoundingClientRect();
        const area = rect.width * rect.height;
        const count = Math.max(35, Math.floor(area * 0.8));

        for (let i = 0; i < count; i++) {
            // 风向偏右上，像微风拂过
            const windDriftX = 0.15 + Math.random() * 1.0;
            const windDriftY = -(0.1 + Math.random() * 0.9);
            const randomSpreadX = (Math.random() - 0.5) * 0.6;
            const randomSpreadY = (Math.random() - 0.5) * 0.6;
            // 延迟启动：靠右/靠下的粒子先飘散，形成从边缘开始剥落的感觉
            const normalizedX = (rect.left + Math.random() * rect.width) / window.innerWidth;
            const normalizedY = (rect.top + Math.random() * rect.height) / window.innerHeight;
            const delay = (normalizedX * 0.6 + normalizedY * 0.4) * 1.8; // 0~1.8s 延迟
            particles.push({
                x: rect.left + Math.random() * rect.width,
                y: rect.top + Math.random() * rect.height,
                originX: rect.left + Math.random() * rect.width,
                originY: rect.top + Math.random() * rect.height,
                vx: windDriftX + randomSpreadX,
                vy: windDriftY + randomSpreadY,
                size: 1.0 + Math.random() * 2.5,
                color: Math.random() > 0.2 ? '#ffffff' : '#cccccc',
                life: 1,
                decay: 0.0025 + Math.random() * 0.01,
                delay: delay,
                started: false
            });
        }
    });

    // 光标也参与消散
    if (cursor) {
        const cr = cursor.getBoundingClientRect();
        for (let i = 0; i < 15; i++) {
            particles.push({
                x: cr.left + Math.random() * cr.width,
                y: cr.top + Math.random() * cr.height,
                originX: cr.left + Math.random() * cr.width,
                originY: cr.top + Math.random() * cr.height,
                vx: 0.15 + Math.random() * 0.7,
                vy: -(0.15 + Math.random() * 0.7),
                size: 1 + Math.random() * 1.5,
                color: '#ffffff',
                life: 1,
                decay: 0.004 + Math.random() * 0.012,
                delay: Math.random() * 1.0,
                started: false
            });
        }
    }

    // 文字柔和淡出（CSS transition 驱动）
    introContent.style.transition = 'opacity 2s ease-out';
    introContent.style.opacity = '0';
    introScreen.style.background = 'transparent';

    const startTime = performance.now();
    let animId;
    function animate(now) {
        const elapsed = (now - startTime) / 1000;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        let alive = 0;
        for (const p of particles) {
            // 延迟激活：时间到了才开始飘动
            if (!p.started) {
                if (elapsed >= p.delay) {
                    p.started = true;
                } else {
                    // 激活前在原位保持不可见
                    alive++;
                    continue;
                }
            }

            const activeTime = elapsed - p.delay;
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.003;
            p.vx *= 0.999;
            p.life -= p.decay;

            if (p.life > 0) {
                alive++;
                // 激活后前0.3s粒子淡入，形成柔和过渡
                const fadeIn = Math.min(activeTime / 0.3, 1);
                ctx.globalAlpha = Math.min(p.life, 0.85) * fadeIn;
                ctx.fillStyle = p.color;
                ctx.fillRect(p.x, p.y, p.size, p.size);
            }
        }

        if (alive > 0) {
            animId = requestAnimationFrame(animate);
        } else {
            introContent.style.transition = '';
            canvas.remove();
            if (callback) callback();
        }
    }

    animId = requestAnimationFrame(animate);
}

// 初始化开场动画
function initIntroAnimation() {
    const introScreen = document.getElementById('introScreen');
    const chars = document.querySelectorAll('.intro-char');
    const subchars = document.querySelectorAll('.intro-subchar');
    const cursor = document.querySelector('.intro-cursor');
    const introText = document.querySelector('.intro-text');
    const introContent = document.querySelector('.intro-content');
    
    if (!introScreen || chars.length === 0 || !cursor || !introText || subchars.length === 0 || !introContent) return;
    
    // 初始化光标位置（在主标题第一个字符前面）
    const textRect = introText.getBoundingClientRect();
    const contentRect = introContent.getBoundingClientRect();
    cursor.style.left = (textRect.left - contentRect.left) + 'px';
    cursor.style.top = (textRect.top - contentRect.top) + 'px'; // 与主标题顶部对齐
    
    // 点击开始动画
    function startAnimation() {
        if (animationStarted) return;
        animationStarted = true;
        
        // 隐藏提示文字
        const hint = document.getElementById('introHint');
        if (hint) hint.style.display = 'none';
        
        // 初始化音频上下文
        initAudioContext();
        
        // 移除点击事件监听
        introScreen.removeEventListener('click', startAnimation);
        introScreen.style.cursor = 'default';
        
        const subtitle = document.querySelector('.intro-subtitle');
        if (!subtitle) return;
        
        // 等待300ms后开始显示第一个字符
        setTimeout(() => {
            // 依次显示主标题每个字符（每个字符间隔0.9秒）
            chars.forEach((char, index) => {
                setTimeout(() => {
                    playTypewriterSound(); // 先播放音效
                    char.classList.add('show'); // 立即显示字符
                    
                    // 计算光标应该移动到的位置
                    const charRect = char.getBoundingClientRect();
                    const cursorOffset = charRect.right - contentRect.left + 10;
                    
                    // 移动光标
                    cursor.style.left = cursorOffset + 'px';
                }, index * 900);
            });
            
            // 等待主标题所有字符显示完成后，开始显示副标题
            const totalCharTime = chars.length * 900;
            setTimeout(() => {
                // 将光标移动到副标题开始位置
                const subtitleRect = subtitle.getBoundingClientRect();
                const subtitleHeight = subtitleRect.height;
                const cursorHeight = 24;
                const verticalOffset = (subtitleHeight - cursorHeight) / 2; // 垂直居中偏移
                cursor.style.left = (subtitleRect.left - contentRect.left) + 'px';
                cursor.style.top = (subtitleRect.top - contentRect.top + verticalOffset - 37) + 'px'; // 副标题光标位置
                cursor.style.height = '24px'; // 缩小光标高度，与副标题字体一致
                
                // 依次显示副标题每个字符（每个字符间隔0.4秒）
                subchars.forEach((char, index) => {
                    setTimeout(() => {
                        playTypewriterSound(); // 先播放音效
                        char.classList.add('show'); // 立即显示字符
                        
                        // 计算光标应该移动到的位置
                        const charRect = char.getBoundingClientRect();
                        const cursorOffset = charRect.right - contentRect.left + 5;
                        
                        // 移动光标
                        cursor.style.left = cursorOffset + 'px';
                    }, index * 400);
                });
                
                // 副标题显示完成后，再等待1秒，然后平滑过渡到游戏页面
                const totalSubCharTime = subchars.length * 400;
                const waitTime = 1000;
                
                setTimeout(() => {
                    // 恐怖淡出效果过渡到游戏页面
                    horrorFadeOut(() => {
                        // 淡出完成后隐藏开场页面
                        introScreen.classList.add('hidden');
                        introContent.style.opacity = '';
                        introContent.style.filter = '';
                        introScreen.style.background = '';

                        // 淡出完成后再显示开场剧情页面
                        showScreen('story');

                        // 淡出完成同时停止音效
                        fadeOutTypewriterSound();
                    });
                }, totalSubCharTime + waitTime);
            }, totalCharTime + 500);
        }, 300);
    }
    
    // 添加点击开始事件
    introScreen.addEventListener('click', startAnimation);
    
    // 预加载音频文件
    const preloadAudio = new Audio('music/typewrite.mp3');
    preloadAudio.load();
}

// 页面加载时初始化开场动画
window.addEventListener('load', initIntroAnimation);

document.addEventListener('DOMContentLoaded', init);
</script>

</body>
</html>