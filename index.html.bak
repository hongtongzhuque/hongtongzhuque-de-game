<script>
// ✅ 标记映射
const markerMap = {
    marker1: "01", marker2: "02", marker3: "03", marker4: "04",
    marker5: "05", marker6: "06", marker7: "07", marker8: "08",
    marker9: "09", marker10: "10", marker11: "11", marker12: "12",
    marker13: "@", marker14: "14", 
};

let screens, inputs, unlockCode1, unlockCode2, unlockCode3, unlockCode4, unlockCode5, unlockCode6, unlockCode7, unlockCode8, unlockCode9, unlockCode10, unlockCode11, unlockCode12, unlockCode13, unlockCode14;
let bookContainer = null;

const CODE1 = "未知的来信";
const CODE2 = "未知的来信2";
const CODE3 = "1-BU-01-02-03-05-06-07-08-09";
const CODE4 = "1-ZHOU-04-12";
const CODE5 = "2-EN-01-02-03-05-06-07-08-09";
const CODE6 = "3-LI-01-05-06";
const CODE7 = "3-SHEN-03-08";
const CODE8 = "3-SU-02-09";
const CODE9 = "4-KI-01-07-09";
const CODE10 = "5-KI-01-03-06-07-08-09";
const CODE11 = "6-DI-01-02-03-05-06-09";
const CODE12 = "7-ZHOU-01-02-03-05-06-07-08-09";
const CODE13 = "8-LI-02-03-05-06-07-09";
const CODE14 = "9-LI-02-09";

function init() {
    screens = {
        story: document.getElementById("storyScreen"),
        info: document.getElementById("infoScreen"),
        third: document.getElementById("thirdScreen"),
        fourth: document.getElementById("fourthScreen"),
        fifth: document.getElementById("fifthScreen"),
        sixth: document.getElementById("sixthScreen"),
        seventh: document.getElementById("seventhScreen"),
        eighth: document.getElementById("eighthScreen"),
        ninth: document.getElementById("ninthScreen"),
        tenth: document.getElementById("tenthScreen"),
        eleventh: document.getElementById("eleventhScreen"),
        twelfth: document.getElementById("twelfthScreen"),
        thirteenth: document.getElementById("thirteenthScreen"),
        fourteenth: document.getElementById("fourteenthScreen"),
        fifteenth: document.getElementById("fifteenthScreen"),
        sixteenth: document.getElementById("sixteenthScreen")
    };

    inputs = {
        story: document.getElementById("storyInput"),
        info: document.getElementById("infoInput"),
        third: document.getElementById("thirdInput"),
        fourth: document.getElementById("fourthInput"),
        fifth: document.getElementById("fifthInput"),
        sixth: document.getElementById("sixthInput"),
        seventh: document.getElementById("seventhInput"),
        eighth: document.getElementById("eighthInput"),
        ninth: document.getElementById("ninthInput"),
        tenth: document.getElementById("tenthInput"),
        eleventh: document.getElementById("eleventhInput"),
        twelfth: document.getElementById("twelfthInput"),
        thirteenth: document.getElementById("thirteenthInput"),
        fourteenth: document.getElementById("fourteenthInput"),
        fifteenth: document.getElementById("fifteenthInput"),
        sixteenth: document.getElementById("sixteenthInput")
    };

    unlockCode1 = document.getElementById("unlockCode1");
    unlockCode2 = document.getElementById("unlockCode2");
    unlockCode3 = document.getElementById("unlockCode3");
    unlockCode4 = document.getElementById("unlockCode4");
    unlockCode5 = document.getElementById("unlockCode5");
    unlockCode6 = document.getElementById("unlockCode6");
    unlockCode7 = document.getElementById("unlockCode7");
    unlockCode8 = document.getElementById("unlockCode8");
    unlockCode9 = document.getElementById("unlockCode9");
    unlockCode10 = document.getElementById("unlockCode10");
    unlockCode11 = document.getElementById("unlockCode11");
    unlockCode12 = document.getElementById("unlockCode12");
    unlockCode13 = document.getElementById("unlockCode13");
    unlockCode14 = document.getElementById("unlockCode14");
    bookContainer = document.querySelector('.pixel-book');
    initMarkers();
    initInputs();

    // 绑定重置对话框按钮
    const resetConfirm = document.getElementById('resetConfirm');
    const resetCancel = document.getElementById('resetCancel');
    const resetDialog = document.getElementById('resetDialog');
    if (resetConfirm) resetConfirm.addEventListener('click', performReset);
    if (resetCancel) resetCancel.addEventListener('click', hideResetDialog);
    // 按下 Esc 关闭对话框
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && resetDialog && !resetDialog.classList.contains('hidden')) {
            hideResetDialog();
        }
    });
}

// 显示/隐藏风格化重置对话框并执行重置
function showResetDialog() {
    const dlg = document.getElementById('resetDialog');
    if (!dlg) return;
    // 先移除 hidden，以便元素参与渲染，再用 requestAnimationFrame 添加 show 触发过渡
    dlg.classList.remove('hidden');
    dlg.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(() => dlg.classList.add('show'));
    
    // 添加点击外部区域触发振动效果
    setupDialogShakeEffect(dlg);
}

// 设置对话框外部点击振动效果
function setupDialogShakeEffect(dialog) {
    const modalBox = dialog.querySelector('.modal-box');
    if (!modalBox) return;
    
    // 移除之前的事件监听器（避免重复绑定）
    dialog.removeEventListener('click', handleDialogClick);
    
    // 添加点击事件监听器
    dialog.addEventListener('click', handleDialogClick);
    
    function handleDialogClick(event) {
        // 检查点击是否发生在对话框外部（即点击了遮罩层）
        if (event.target === dialog) {
            triggerShakeEffect(modalBox);
        }
    }
}

// 触发振动效果
function triggerShakeEffect(modalBox) {
    // 如果已经在振动，则不重复触发
    if (modalBox.classList.contains('shaking')) return;
    
    // 添加振动类
    modalBox.classList.add('shaking');
    
    // 播放音效（可选，增强恐怖效果）
    playHorrorSound();
    
    // 0.8秒后移除振动效果
    setTimeout(() => {
        modalBox.classList.remove('shaking');
    }, 800);
}

// 播放恐怖音效（使用Web Audio API生成简单的恐怖音效）
function playHorrorSound() {
    try {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        
        // 设置低频锯齿波，营造恐怖氛围
        oscillator.type = 'sawtooth';
        oscillator.frequency.setValueAtTime(80, audioContext.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(40, audioContext.currentTime + 0.3);
        
        // 设置音量包络
        gainNode.gain.setValueAtTime(0.3, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
        
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.3);
    } catch (error) {
        // 音频播放失败时静默处理
        console.log('音频播放失败:', error);
    }
}

// 全局打字机音效对象
let typewriterAudio = null;
let animationStarted = false; // 动画是否已开始
let audioContext = null; // 音频上下文

// 初始化音频上下文
function initAudioContext() {
    if (!audioContext) {
        audioContext = new (window.AudioContext || window.webkitAudioContext)();
    }
    if (audioContext.state === 'suspended') {
        audioContext.resume();
    }
}

// 播放老式打字机音效
function playTypewriterSound() {
    try {
        initAudioContext(); // 确保音频上下文已初始化
        
        // 如果已有音频对象，先停止播放
        if (typewriterAudio) {
            typewriterAudio.pause();
            typewriterAudio.currentTime = 0;
        }
        
        // 创建新的音频对象
        typewriterAudio = new Audio('music/typewrite.mp3');
        typewriterAudio.volume = 1.0;//开场动画音量
        typewriterAudio.currentTime = 0; // 重置播放位置
        typewriterAudio.preload = 'auto'; // 预加载音频
        
        const playPromise = typewriterAudio.play();
        if (playPromise !== undefined) {
            playPromise.then(() => {
                console.log('打字机音效播放成功');
            }).catch(error => {
                console.log('打字机音效播放失败:', error);
            });
        }
    } catch (error) {
        console.log('打字机音效播放失败:', error);
    }
}

// 淡出打字机音效
function fadeOutTypewriterSound() {
    if (!typewriterAudio) return;
    
    try {
        const fadeDuration = 1000; // 1秒淡出
        const fadeSteps = 20; // 分20步淡出
        const fadeInterval = fadeDuration / fadeSteps;
        const volumeStep = typewriterAudio.volume / fadeSteps;
        
        let currentStep = 0;
        const fadeIntervalId = setInterval(() => {
            currentStep++;
            typewriterAudio.volume = Math.max(0, typewriterAudio.volume - volumeStep);
            
            if (currentStep >= fadeSteps) {
                clearInterval(fadeIntervalId);
                typewriterAudio.pause();
                typewriterAudio.currentTime = 0;
            }
        }, fadeInterval);
    } catch (error) {
        console.log('音效淡出失败:', error);
    }
}

// 播放危险警告音效（线索不存在时触发）
function playDangerSound() {
    try {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        
        // 创建主振荡器（低频恐怖音）
        const mainOsc = audioContext.createOscillator();
        const mainGain = audioContext.createGain();
        
        // 创建高频刺耳音
        const highOsc = audioContext.createOscillator();
        const highGain = audioContext.createGain();
        
        // 创建噪音（增强恐怖感）
        const bufferSize = audioContext.sampleRate * 0.5;
        const noiseBuffer = audioContext.createBuffer(1, bufferSize, audioContext.sampleRate);
        const noiseData = noiseBuffer.getChannelData(0);
        for (let i = 0; i < bufferSize; i++) {
            noiseData[i] = Math.random() * 2 - 1;
        }
        const noiseSource = audioContext.createBufferSource();
        noiseSource.buffer = noiseBuffer;
        const noiseGain = audioContext.createGain();
        const noiseFilter = audioContext.createBiquadFilter();
        noiseFilter.type = 'lowpass';
        noiseFilter.frequency.setValueAtTime(500, audioContext.currentTime);
        
        // 连接音频节点
        mainOsc.connect(mainGain);
        mainGain.connect(audioContext.destination);
        
        highOsc.connect(highGain);
        highGain.connect(audioContext.destination);
        
        noiseSource.connect(noiseFilter);
        noiseFilter.connect(noiseGain);
        noiseGain.connect(audioContext.destination);
        
        // 设置主振荡器参数（低频下降）
        mainOsc.type = 'sawtooth';
        mainOsc.frequency.setValueAtTime(120, audioContext.currentTime);
        mainOsc.frequency.exponentialRampToValueAtTime(30, audioContext.currentTime + 0.6);
        mainGain.gain.setValueAtTime(0.25, audioContext.currentTime);
        mainGain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.6);
        
        // 设置高频振荡器参数（刺耳上升）
        highOsc.type = 'square';
        highOsc.frequency.setValueAtTime(800, audioContext.currentTime);
        highOsc.frequency.exponentialRampToValueAtTime(200, audioContext.currentTime + 0.4);
        highGain.gain.setValueAtTime(0.08, audioContext.currentTime);
        highGain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.4);
        
        // 设置噪音参数
        noiseGain.gain.setValueAtTime(0.04, audioContext.currentTime);
        noiseGain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.3);
        
        // 启动所有音频源
        mainOsc.start(audioContext.currentTime);
        mainOsc.stop(audioContext.currentTime + 0.6);
        
        highOsc.start(audioContext.currentTime);
        highOsc.stop(audioContext.currentTime + 0.4);
        
        noiseSource.start(audioContext.currentTime);
        noiseSource.stop(audioContext.currentTime + 0.3);
        
    } catch (error) {
        // 音频播放失败时静默处理
        console.log('危险音效播放失败:', error);
    }
}

// 播放消息提示音效
function playNotificationSound() {
    try {
        const audioContext = new (window.AudioContext || window.webkitAudioContext)();
        
        // 创建振荡器
        const oscillator = audioContext.createOscillator();
        const gainNode = audioContext.createGain();
        
        oscillator.connect(gainNode);
        gainNode.connect(audioContext.destination);
        
        // 设置正弦波，营造诡异的通知音
        oscillator.type = 'sine';
        oscillator.frequency.setValueAtTime(800, audioContext.currentTime);
        oscillator.frequency.exponentialRampToValueAtTime(600, audioContext.currentTime + 0.15);
        oscillator.frequency.exponentialRampToValueAtTime(800, audioContext.currentTime + 0.3);
        
        // 设置音量包络
        gainNode.gain.setValueAtTime(0.2, audioContext.currentTime);
        gainNode.gain.exponentialRampToValueAtTime(0.15, audioContext.currentTime + 0.15);
        gainNode.gain.exponentialRampToValueAtTime(0.2, audioContext.currentTime + 0.3);
        gainNode.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
        
        oscillator.start(audioContext.currentTime);
        oscillator.stop(audioContext.currentTime + 0.5);
    } catch (error) {
        console.log('通知音效播放失败:', error);
    }
}

function playAudioFromBase64String(base64Text) {
    const trimmed = base64Text.trim();
    if (!trimmed) return Promise.reject(new Error('Base64 音频内容为空'));
    let src;
    if (trimmed.startsWith('data:audio')) {
        src = trimmed;
    } else {
        const prefix = trimmed.slice(0, 4);
        const mimeType = prefix === 'UklG' ? 'audio/wav' : prefix === 'SUQz' ? 'audio/mpeg' : 'audio/mpeg';
        src = `data:${mimeType};base64,${trimmed}`;
    }
    if (jueBieShuAudio) {
        jueBieShuAudio.pause();
        jueBieShuAudio = null;
    }
    jueBieShuAudio = new Audio(src);
    jueBieShuAudio.volume = 1.0;
    return jueBieShuAudio.play().catch(error => {
        console.log('诀别书音频播放失败:', error);
    });
}



// 播放翻书音效（正确线索输入时触发）
        function playPageTurnSound() {
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const audio = new Audio('music/book1.mp3');
                const source = audioContext.createMediaElementSource(audio);
                const gainNode = audioContext.createGain();
                
                source.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                gainNode.gain.setValueAtTime(0.5, audioContext.currentTime);
                
                audio.play().catch(error => {
                    console.log('翻书音效播放失败:', error);
                });
                
                audio.onloadedmetadata = () => {
                    const duration = audio.duration;
                    const fadeOutStartTime = duration - 0.5;
                    gainNode.gain.setValueAtTime(0.5, audioContext.currentTime);
                    gainNode.gain.linearRampToValueAtTime(0.5, audioContext.currentTime + fadeOutStartTime);
                    gainNode.gain.linearRampToValueAtTime(0, audioContext.currentTime + duration);
                };
            } catch (error) {
                console.log('翻书音效播放失败:', error);
            }
        }

function hideResetDialog() {
    const dlg = document.getElementById('resetDialog');
    if (!dlg) return;
    // 移除 show 启动淡出，淡出结束后再添加 hidden
    dlg.classList.remove('show');
    dlg.setAttribute('aria-hidden', 'true');
    // 与 CSS 过渡时长保持同步（520ms），稍作延迟后隐藏
    setTimeout(() => dlg.classList.add('hidden'), 540);
}

function performReset() {
    const dlg = document.getElementById('resetDialog');
    const box = dlg ? dlg.querySelector('.modal-box') : null;
    const infoScreen = document.getElementById('infoScreen'); // 获取第二页元素
    if (!dlg || !box || !infoScreen) return;
    
    // 先隐藏所有线索代码，避免燃烧时残留
    if (unlockCode1) unlockCode1.classList.add('hidden');
    if (unlockCode2) unlockCode2.classList.add('hidden');
    if (unlockCode3) unlockCode3.classList.add('hidden');
    if (unlockCode4) unlockCode4.classList.add('hidden');
    if (unlockCode5) unlockCode5.classList.add('hidden');
    if (unlockCode6) unlockCode6.classList.add('hidden');
    if (unlockCode7) unlockCode7.classList.add('hidden');
    if (unlockCode8) unlockCode8.classList.add('hidden');
    if (unlockCode9) unlockCode9.classList.add('hidden');
    if (unlockCode10) unlockCode10.classList.add('hidden');
    if (unlockCode11) unlockCode11.classList.add('hidden');
    if (unlockCode12) unlockCode12.classList.add('hidden');
    if (unlockCode13) unlockCode13.classList.add('hidden');
    if (unlockCode14) unlockCode14.classList.add('hidden');

    // 核心修复：先移除 hidden 类，否则 display:none 会导致动画无法播放，元素瞬间消失
    dlg.classList.remove('hidden');
    infoScreen.classList.remove('hidden');

    // 添加燃烧动画类（对话框和第二页同时燃烧）
    box.classList.add('burning');
    infoScreen.classList.add('burning');
    dlg.classList.add('fade-out-overlay');

    // 4 秒后完成重置逻辑，确保逐行消失效果完整播放
    setTimeout(() => {
        try {
            // 清除所有localStorage数据
            localStorage.clear();
            
            // 重置所有标记
            const markers = document.querySelectorAll('.marker');
            markers.forEach(marker => {
                marker.textContent = markerMap[marker.dataset.key] || "@";
            });
            
            // 重置所有线索代码
            if (unlockCode1) { unlockCode1.classList.add("hidden"); unlockCode1.textContent = ""; }
            if (unlockCode2) { unlockCode2.classList.add("hidden"); unlockCode2.textContent = ""; }
            if (unlockCode3) { unlockCode3.classList.add("hidden"); unlockCode3.textContent = ""; }
            if (unlockCode4) { unlockCode4.classList.add("hidden"); unlockCode4.textContent = ""; }
            if (unlockCode5) { unlockCode5.classList.add("hidden"); unlockCode5.textContent = ""; }
            if (unlockCode6) { unlockCode6.classList.add("hidden"); unlockCode6.textContent = ""; }
            if (unlockCode7) { unlockCode7.classList.add("hidden"); unlockCode7.textContent = ""; }
            if (unlockCode8) { unlockCode8.classList.add("hidden"); unlockCode8.textContent = ""; }
            if (unlockCode9) { unlockCode9.classList.add("hidden"); unlockCode9.textContent = ""; }
            if (unlockCode10) { unlockCode10.classList.add("hidden"); unlockCode10.textContent = ""; }
            if (unlockCode11) { unlockCode11.classList.add("hidden"); unlockCode11.textContent = ""; }
            if (unlockCode12) { unlockCode12.classList.add("hidden"); unlockCode12.textContent = ""; }
            if (unlockCode13) { unlockCode13.classList.add("hidden"); unlockCode13.textContent = ""; }
            if (unlockCode14) { unlockCode14.classList.add("hidden"); unlockCode14.textContent = ""; }

            // 清空所有输入框
            Object.values(inputs).forEach(input => input && (input.value = ""));

            dlg.classList.add('hidden');
            dlg.classList.remove('show', 'fade-out-overlay');
            box.classList.remove('burning');
            infoScreen.classList.remove('burning');
            infoScreen.classList.add('hidden');

            void box.offsetWidth;
            void infoScreen.offsetWidth;

            // 重置开场动画状态
            animationStarted = false;

            // 显示开场页面
            const introScreen = document.getElementById('introScreen');
            const introContent = document.querySelector('.intro-content');
            if (introScreen) {
                introScreen.classList.remove('hidden');
                introScreen.classList.remove('fade-out');
                introScreen.style.background = '';
                introScreen.style.transition = '';
                if (introContent) {
                    introContent.style.opacity = '';
                    introContent.style.filter = '';
                    introContent.style.transition = '';
                }
                const cursor = document.querySelector('.intro-cursor');
                if (cursor) cursor.style.opacity = '';

                // 清除残留的消散画布
                document.querySelectorAll('.dissolve-canvas').forEach(c => c.remove());

                // 恢复剧情页面原始HTML并清除动画标记
                const storyContent = document.querySelector('.story-content');
                if (storyContent && storyContent.dataset.originalHtml) {
                    storyContent.innerHTML = storyContent.dataset.originalHtml;
                    delete storyContent.dataset.animated;
                    delete storyContent.dataset.originalHtml;
                }
                
                // 重置所有字符显示状态
                const chars = document.querySelectorAll('.intro-char');
                const subchars = document.querySelectorAll('.intro-subchar');
                chars.forEach(char => char.classList.remove('show'));
                subchars.forEach(char => char.classList.remove('show'));
                
                // 显示提示文字
                const hint = document.getElementById('introHint');
                if (hint) hint.style.display = 'block';
                
                // 重新初始化开场动画
                initIntroAnimation();
            }
            
            // 隐藏所有其他页面
            Object.values(screens).forEach(screen => {
                if (screen && screen.id !== 'introScreen') {
                    screen.classList.add('hidden');
                    screen.classList.remove('visible');
                }
            });
            
            alert("一切将重新开始。");
        } catch (error) {
            console.error("重置失败:", error);
            alert("重置出错，请刷新重试。");
        }
    }, 4200);
}


function initMarkers() {
    const markers = document.querySelectorAll('.marker');
    markers.forEach(marker => {
        const key = marker.dataset.key;
        const saved = localStorage.getItem(key);
        marker.textContent = saved && saved.trim() ? saved : markerMap[key] || "@";

        marker.addEventListener('click', () => {
            if (marker.textContent === markerMap[key]) {
                marker.textContent = "";
                const range = document.createRange();
                range.selectNodeContents(marker);
                range.collapse(false);
                const sel = window.getSelection();
                sel.removeAllRanges();
                sel.addRange(range);
            }
        });

        marker.addEventListener('input', () => {
            const current = marker.textContent;
            if (current && current.trim()) {
                localStorage.setItem(key, current);
                syncMarkers(key, current);  // 新增：同步所有标记
            } else {
                localStorage.removeItem(key);
                syncMarkers(key, markerMap[key] || "@");  // 新增：同步所有标记
            }
        });

        marker.addEventListener('blur', () => {
            if (!marker.textContent.trim()) {
                const defaultValue = markerMap[key] || "@";
                marker.textContent = defaultValue;
                localStorage.setItem(key, defaultValue);
                syncMarkers(key, defaultValue);  // 新增：同步所有标记
            }
        });

        marker.addEventListener('keydown', e => {
            if (e.key === 'Enter') { e.preventDefault(); marker.blur(); }
        });
    });
}

// 新增函数：同步所有相同标记
function syncMarkers(key, value) {
    const allMarkers = document.querySelectorAll(`.marker[data-key="${key}"]`);
    allMarkers.forEach(marker => {
        if (marker.textContent !== value) {
            marker.textContent = value;
        }
    });
}

function showScreen(name) {
    try {
        const target = screens[name];
        if (!target) {
            console.error('showScreen: 未找到页面 "' + name + '"');
            return;
        }
        // 场景过渡：短暂黑闪模拟翻页
        const flash = document.createElement('div');
        flash.style.cssText = 'position:fixed;inset:0;background:#000;z-index:9998;pointer-events:none;opacity:0;';
        document.body.appendChild(flash);
        requestAnimationFrame(() => {
            flash.style.transition = 'opacity 0.06s';
            flash.style.opacity = '1';
        });
        setTimeout(() => {
            flash.style.opacity = '0';
            setTimeout(() => flash.remove(), 80);
        }, 70);

        Object.values(screens).forEach(s => {
            if (s) { s.classList.add("hidden"); s.classList.remove("visible"); }
        });
        target.classList.remove("hidden");
        void target.offsetWidth;
        target.classList.add("visible");
        const input = inputs[name];
        if (input) input.focus();
        if (name === "info") {
            checkUnlocks();
            if (bookContainer) {
                bookContainer.classList.remove('book-open');
                void bookContainer.offsetWidth;
                bookContainer.classList.add('book-open');
            }
        } else if (bookContainer) {
            bookContainer.classList.remove('book-open');
        }

        if (name === "third" || name === "fourth" || name === "fifth" || name === "sixth" || name === "seventh" || name === "eighth" || name === "ninth" || name === "tenth" || name === "eleventh" || name === "twelfth" || name === "thirteenth" || name === "fourteenth" || name === "fifteenth" || name === "sixteenth") {
            playPageTurnSound();
        }

        if (name === "sixth") {
            const seenKey = 'seenSixthFirstTime';
            if (localStorage.getItem(seenKey) !== 'true') {
                localStorage.setItem(seenKey, 'true');
                setTimeout(() => {
                    showToastNotification('未知的来信2');
                }, 3000);
            }
        }

        if (name === "story") {
            animateStoryText();
        }
    } catch (e) {
        console.error('showScreen 出错:', e);
    }
}

